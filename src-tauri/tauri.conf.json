{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cairn",
  "version": "0.1.0",
  "identifier": "io.github.yokiwa.cairn",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm -C ../ui dev",
    "beforeBuildCommand": "pnpm -C ../ui build"
  },
  "app": {
    "windows": [
      {
        "title": "Cairn",
        "width": 1200,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "appimage", "deb"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Game",
    "shortDescription": "A Minecraft: Java Edition launcher",
    "longDescription": "Cairn installs Minecraft, mod loaders and Java for you, and launches the game. Not affiliated with Mojang or Microsoft.",
    "copyright": "Copyright (C) 2026 Cairn contributors. GPL-3.0-only.",
    "license": "GPL-3.0-only"
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/Yokiwa/cairn/releases/latest/download/latest.json"]
    }
  }
}
